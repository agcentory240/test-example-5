{
    "name": "test/import-products",
    "description": "Product import/export (Slim + Angular)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-amqp": "*",
        "ext-gd": "*",
        "ext-pdo_pgsql": "*",
        "ext-zip": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.3",
        "monolog/monolog": "^3.8",
        "php-di/php-di": "^7.0",
        "phpoffice/phpspreadsheet": "^5.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/amqp-messenger": "^7.2",
        "symfony/http-client": "^7.2",
        "symfony/messenger": "^7.2",
        "symfony/uid": "^7.2",
        "vlucas/phpdotenv": "^5.6",
        "zircote/swagger-php": "^5.0"
    },
    "require-dev": {
        "doctrine/data-fixtures": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
