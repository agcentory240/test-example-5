{
    "name": "test/import-products",
    "description": "Product import/export (Slim + Angular)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.0",
        "monolog/monolog": "^3.8",
        "php-di/php-di": "^7.0",
        "phpoffice/phpspreadsheet": "^5.11",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/amqp-messenger": "^7.4",
        "symfony/cache": "^7.1",
        "symfony/http-client": "^7.4",
        "symfony/messenger": "^7.4",
        "vlucas/phpdotenv": "^5.6",
        "zircote/swagger-php": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.36"
        }
    }
}
