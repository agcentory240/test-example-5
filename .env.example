# --- Приложение ---
# Режим работы: dev | prod
APP_ENV=dev
# Детальный вывод ошибок Slim: 1 (вкл) | 0 (выкл).
# Если не задано — включается в dev, выключается в prod
APP_DEBUG=1

# --- CORS ---
# Разрешённые origins через запятую (фронтенд)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# --- Rate limiting (POST /api/import) ---
# Максимум импортов за окно с одного IP
RATE_LIMIT_MAX=10
# Размер окна в секундах (3600 = 1 час)
RATE_LIMIT_WINDOW=3600

# --- PostgreSQL (сервис db) ---
# Хост БД внутри docker-сети (имя сервиса)
DB_HOST=db
# Порт PostgreSQL
DB_PORT=5432
# Имя базы данных
DB_NAME=app
# Пользователь БД
DB_USER=app
# Пароль пользователя БД
DB_PASSWORD=secret

# --- RabbitMQ (сервис rabbitmq) ---
# Хост брокера внутри docker-сети (имя сервиса)
RABBITMQ_HOST=rabbitmq
# AMQP-порт брокера
RABBITMQ_PORT=5672
# Виртуальный хост RabbitMQ (по умолчанию "/")
RABBITMQ_VHOST=/
# Пользователь RabbitMQ (management UI: http://localhost:15672)
RABBITMQ_USER=guest
# Пароль RabbitMQ
RABBITMQ_PASSWORD=guest
# Имя exchange для сообщений Messenger
RABBITMQ_EXCHANGE=messages
# Имя очереди для сообщений Messenger
RABBITMQ_QUEUE=messages

# --- pgAdmin (сервис pgadmin) ---
# Логин для входа в pgAdmin (UI: http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
# Пароль для входа в pgAdmin
PGADMIN_DEFAULT_PASSWORD=admin
