# --- Приложение ---
# Режим работы: dev | prod
APP_ENV=dev

# --- PostgreSQL (сервис db) ---
# Хост БД внутри docker-сети (имя сервиса)
DB_HOST=db
# Порт PostgreSQL
DB_PORT=5432
# Имя базы данных
DB_NAME=app
# Пользователь БД
DB_USER=app
# Пароль пользователя БД
DB_PASSWORD=secret

# --- RabbitMQ (сервис rabbitmq) ---
# Хост брокера внутри docker-сети (имя сервиса)
RABBITMQ_HOST=rabbitmq
# AMQP-порт брокера
RABBITMQ_PORT=5672
# Пользователь RabbitMQ (management UI: http://localhost:15672)
RABBITMQ_USER=guest
# Пароль RabbitMQ
RABBITMQ_PASSWORD=guest
